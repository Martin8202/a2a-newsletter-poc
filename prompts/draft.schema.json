{
  "type": "object",
  "properties": {
    "period": {
      "type": "object",
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      },
      "required": ["start", "end"]
    },
    "top3": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "related_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["text", "related_ids"]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "section": { "type": "string", "enum": ["onprem", "industry"] },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "key_points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "quote": { "type": "string" },
                "url": { "type": "string" }
              },
              "required": ["text", "quote", "url"]
            }
          },
          "why_hot": { "type": "string" },
          "onprem_value": {
            "type": "object",
            "properties": {
              "hardware": { "type": "string" },
              "inference_efficiency": { "type": "string" },
              "license": { "type": "string" },
              "compliance": { "type": "string" }
            },
            "required": ["hardware", "inference_efficiency", "license", "compliance"]
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["community", "media", "pain_point"] },
                "evidence": { "type": "string" },
                "url": { "type": "string" }
              },
              "required": ["type", "evidence", "url"]
            }
          },
          "heat": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "enum": ["hn", "reddit", "hf_trending", "github", "media"] },
                "url": { "type": "string" }
              },
              "required": ["kind", "url"]
            }
          },
          "published_date": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "type": { "type": "string", "enum": ["original", "discussion", "report", "tw_translation"] },
                "url": { "type": "string" }
              },
              "required": ["label", "type", "url"]
            }
          }
        },
        "required": ["id", "section", "title", "summary", "key_points", "why_hot", "onprem_value",
                     "signals", "heat", "published_date", "sources"]
      }
    }
  },
  "required": ["period", "top3", "items"]
}
